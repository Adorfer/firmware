+<%- if self.warn_unsaved then %>
+<script>
+	(function() {
+		// Warnt beim Verlassen der Seite, solange Eingaben nicht gespeichert
+		// sind (etwa beim Wechsel zu den Erweiterten Einstellungen). Den Text
+		// bestimmt der Browser selbst.
+		var form = document.getElementById('form-<%=id%>').parentNode;
+		var dirty = false;
+		form.addEventListener('input', function() { dirty = true; });
+		form.addEventListener('change', function() { dirty = true; });
+		form.addEventListener('submit', function() { dirty = false; });
+		window.addEventListener('beforeunload', function(e) {
+			if (!dirty)
+				return;
+			e.preventDefault();
+			e.returnValue = '';
+			return '';
+		});
+	})();
+</script>
