 function f:write()
+	-- "Speichern": Die Felder haben ihre Werte schon geschrieben (uci:save,
+	-- also nach /tmp/.uci; die Seite zeigt sie daraus wieder an). Kein
+	-- configured, kein gluon-reconfigure, kein Neustart - das bleibt
+	-- "Speichern & Neustarten" vorbehalten. Der Knopf schickt per formaction
+	-- an dieselbe Adresse mit ?save-only=1; die Modell-Umgebung kennt die
+	-- Anfrage nicht, die CGI-Umgebung schon.
+	if (os.getenv('QUERY_STRING') or ''):match('save%-only=1') then
+		f.notice = translate('Saved. The settings take effect only after "Save & restart".')
+		return
+	end
+
