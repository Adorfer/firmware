diff --git a/patches/packages/ffac/0001-mt7915-maxinactivity-decide-per-radio-not-per-build-target.patch b/patches/packages/ffac/0001-mt7915-maxinactivity-decide-per-radio-not-per-build-target.patch
new file mode 100644
index 00000000..5b522729
--- /dev/null
+++ b/patches/packages/ffac/0001-mt7915-maxinactivity-decide-per-radio-not-per-build-target.patch
@@ -0,0 +1,173 @@
+From: Neanderfunk <projekt@neanderfunk.de>
+Date: Mon, 7 Sep 2026 14:00:13 +0200
+Subject: mt7915-maxinactivity: decide per radio, not per build target
+
+The package sets max_inactivity on every client_* interface as soon as it is
+installed, and it is installed for whole targets. On ramips/mt7621 that is too
+coarse: a Xiaomi Mi Router 4A Gigabit is mt7621 with mt7603e and mt76x2e and
+carries no mt7915 at all, yet both of its radios were given the 10 s timer.
+Neither chip is affected by openwrt/mt76#1009, so there the short timer only
+costs a null-data poll per idle station every 10 s and risks dropping clients
+that sleep longer than that.
+
+Look at the kernel module behind each radio's phy instead, the same test
+neanderfunk-mt7915-backlog makes: the module rather than the driver name,
+because SoC-integrated mt7915 registers as mt798x-wmac while the module stays
+mt7915e. Radios that are not mt7915 have max_inactivity removed rather than
+just skipped - /etc/config/wireless survives sysupgrade, so a value set by the
+previous version would otherwise stay on the node for good.
+
+If the phy cannot be identified at all - it may not have registered yet when
+gluon-reconfigure runs - the workaround is applied as before and the reason is
+logged, so an mt7915 board never silently loses it.
+
+The mapping from a wifi-device section to its phy is left to iwinfo: the second
+radio of a dual-band SoC is addressed by a "+1" suffix with no sysfs
+counterpart, and on some boards the uci path lacks the "platform/" prefix that
+the sysfs path has. Hence the added dependency.
+---
+ ffac-mt7915-maxinactivity/Makefile            |   3 +-
+ .../gluon/upgrade/390-mt7915-maxinactivity    | 109 +++++++++++++++++-
+ 2 files changed, 107 insertions(+), 5 deletions(-)
+
+diff --git a/ffac-mt7915-maxinactivity/Makefile b/ffac-mt7915-maxinactivity/Makefile
+index 756e107..5f7a57d 100644
+--- a/ffac-mt7915-maxinactivity/Makefile
++++ b/ffac-mt7915-maxinactivity/Makefile
+@@ -4,7 +4,7 @@ include $(TOPDIR)/rules.mk
+ 
+ PKG_NAME:=ffac-mt7915-maxinactivity
+ PKG_VERSION:=1.0
+-PKG_RELEASE:=1
++PKG_RELEASE:=2
+ 
+ PKG_LICENSE:=BSD-2-Clause
+ 
+@@ -12,6 +12,7 @@ include $(TOPDIR)/../package/gluon.mk
+ 
+ define Package/$(PKG_NAME)
+   TITLE:=Set maxinactivity for hostapd as hotfix for mt7915 tx issues
++  DEPENDS:=+iwinfo
+ endef
+ 
+ define Package/$(PKG_NAME)/description
+diff --git a/ffac-mt7915-maxinactivity/luasrc/lib/gluon/upgrade/390-mt7915-maxinactivity b/ffac-mt7915-maxinactivity/luasrc/lib/gluon/upgrade/390-mt7915-maxinactivity
+index fd2ce48..b4ae98c 100755
+--- a/ffac-mt7915-maxinactivity/luasrc/lib/gluon/upgrade/390-mt7915-maxinactivity
++++ b/ffac-mt7915-maxinactivity/luasrc/lib/gluon/upgrade/390-mt7915-maxinactivity
+@@ -5,10 +5,111 @@ local max_inactivity_time = uci:get('mt7915-maxinactivity', 'settings', 'max_ina
+ 
+ -- fixes for mt7915 disassoc issues
+ -- https://github.com/openwrt/mt76/issues/1009
++--
++-- The workaround belongs on radios that are actually driven by mt7915. Which
++-- targets the package is built for is not a good enough test for that: on
++-- ramips/mt7621 an mt7603/mt76x2 combination is just as common (a Xiaomi Mi
++-- Router 4A Gigabit carries both and no mt7915 at all), and those chips are
++-- not affected by the bug above. Shortening their inactivity timer from
++-- hostapd's 300 s default down to 10 s buys nothing there and costs a poll per
++-- idle station every 10 s.
++--
++-- So the decision is made per radio at runtime, from the kernel module behind
++-- its phy. The module, not the driver name: where mt7915 is integrated into
++-- the SoC the driver is called mt798x-wmac while the module is still mt7915e,
++-- and a test on the driver name would miss exactly the filogic boards that
++-- show the symptom most clearly.
++
++local function trim(s)
++	if not s then return nil end
++	s = s:gsub('^%s+', ''):gsub('%s+$', '')
++	if s == '' then return nil end
++	return s
++end
++
++local function popen_line(command)
++	local f = io.popen(command)
++	if not f then return nil end
++	local line = f:read('*l')
++	f:close()
++	return trim(line)
++end
++
++-- The phy behind a wifi-device section. iwinfo already knows how to map the
++-- uci "path" onto a phy name, and that mapping is not trivial: the second
++-- radio of a dual-band SoC is addressed by a "+1" suffix that has no sysfs
++-- counterpart, and on some boards the uci path lacks the "platform/" prefix
++-- the sysfs path carries. Re-implementing that here would only reproduce it
++-- badly, so ask iwinfo and fall back to the radioN -> phyN convention.
++local function phy_of(radio_name)
++	local phy = popen_line('iwinfo nl80211 phyname ' .. radio_name .. ' 2>/dev/null')
++	if phy and phy:match('^phy%d+$') then
++		return phy
++	end
++
++	local index = radio_name:match('^radio(%d+)$')
++	if index then
++		return 'phy' .. index
++	end
++
++	return nil
++end
++
++-- The kernel module driving that phy, or nil if it cannot be determined.
++local function module_of(phy)
++	if not phy then return nil end
++
++	local driver = '/sys/class/ieee80211/' .. phy .. '/device/driver'
++	local path = popen_line('readlink -f ' .. driver .. '/module 2>/dev/null')
++		or popen_line('readlink -f ' .. driver .. ' 2>/dev/null')
++	if not path then return nil end
++
++	return path:match('([^/]+)$')
++end
++
++local function log(message)
++	os.execute('logger -t ffac-mt7915-maxinactivity -p 5 "' .. message .. '" 2>/dev/null')
++end
++
++local checked = {}
++
++local function is_mt7915(radio_name)
++	if checked[radio_name] == nil then
++		local module = module_of(phy_of(radio_name))
++
++		if not module then
++			-- Undecidable, which happens when the phy has not registered yet.
++			-- Apply the workaround rather than silently dropping it on a board
++			-- that needs it - that is the behaviour this package had before.
++			log(radio_name .. ': wifi driver not identifiable, applying max_inactivity anyway')
++			checked[radio_name] = true
++		else
++			checked[radio_name] = (module:match('^mt7915') or module:match('^mt798')) ~= nil
++		end
++	end
++
++	return checked[radio_name]
++end
++
+ uci:foreach('wireless', 'wifi-iface', function(config)
+-        local name = config['.name']
+-        if name:match('^client_') then
+-                uci:set('wireless', name, 'max_inactivity', max_inactivity_time)
+-        end
++	local name = config['.name']
++	if not name:match('^client_') then
++		return
++	end
++
++	local radio_name = config.device
++	if not radio_name then
++		return
++	end
++
++	if is_mt7915(radio_name) then
++		uci:set('wireless', name, 'max_inactivity', max_inactivity_time)
++	else
++		-- Take a value off again that an earlier version of this package set
++		-- on every client interface. /etc/config/wireless survives sysupgrade,
++		-- so without this the setting would stay on a non-mt7915 radio for
++		-- good.
++		uci:delete('wireless', name, 'max_inactivity')
++	end
+ end)
+ uci:commit('wireless')
