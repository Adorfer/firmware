From: Freifunk im Neanderland <projekt@neanderfunk.de>
Subject: image: squashfs block size per device

The squashfs block size is a target-wide setting
(CONFIG_TARGET_SQUASHFS_BLOCK_SIZE, 256 KiB in Gluon). Smaller blocks
cost flash (+6.8 % rootfs at 64 KiB on ath79-generic) but reduce read
amplification and the fixed decompression buffers - which matters on
devices with 64 MB RAM and two radios, where the page cache is only a
few MB. Target-wide 64 KiB is not an option: some devices of the same
target (Archer C6 v2, OM2P family) would keep only 192 KiB of overlay.

Allow a per-device override, the same way FS_OPTIONS already does it for
ubifs:

- DEVICE_SQUASHFS_BLOCKSIZE (KiB), preset per device from
  SQUASHFS_BLOCKSIZE/<device>, which a build system can set in the
  optional file target/linux/<board>/image/squashfs-blocksize.mk
  without touching the device definitions.
- A device with its own block size gets its own rootfs file,
  root.squashfs+bs=<n>k+pkg=<id>: the block size becomes part of the
  rootfs ID, so devices with the same package list but different block
  sizes no longer share one rootfs.
- mksquashfs gets -b from the rootfs parameters, falling back to the
  target default. Without any override the command line and the rootfs
  file names are unchanged apart from the position of -b.

Signed-off-by: Freifunk im Neanderland <projekt@neanderfunk.de>
---
--- a/include/image.mk
+++ b/include/image.mk
@@ -75,8 +75,11 @@
 JFFS2OPTS += $(MKFS_DEVTABLE_OPT)
 
 SQUASHFS_BLOCKSIZE := $(CONFIG_TARGET_SQUASHFS_BLOCK_SIZE)k
-SQUASHFSOPT := -b $(SQUASHFS_BLOCKSIZE)
-SQUASHFSOPT += -p '/dev d 755 0 0' -p '/dev/console c 600 0 0 5 1'
+# The block size is passed per rootfs (see Image/mkfs/squashfs-common), so a
+# device can override it with DEVICE_SQUASHFS_BLOCKSIZE. Per-device values of a
+# target, as "SQUASHFS_BLOCKSIZE/<device> := <KiB>", may come from this file:
+-include $(TOPDIR)/target/linux/$(BOARD)/image/squashfs-blocksize.mk
+SQUASHFSOPT := -p '/dev d 755 0 0' -p '/dev/console c 600 0 0 5 1'
 SQUASHFSOPT += $(if $(CONFIG_SELINUX),-xattrs,-no-xattrs)
 SQUASHFSCOMP := gzip
 LZMA_XZ_OPTIONS := -Xpreset 9 -Xe -Xlc 0 -Xlp 2 -Xpb 2
@@ -237,7 +240,9 @@
 define Image/mkfs/squashfs-common
 	$(STAGING_DIR_HOST)/bin/mksquashfs4 $(call mkfs_target_dir,$(1)) $@ \
 		-nopad -noappend -root-owned \
-		-comp $(SQUASHFSCOMP) $(SQUASHFSOPT)
+		-comp $(SQUASHFSCOMP) \
+		-b $(call param_get_default,bs,$(1),$(SQUASHFS_BLOCKSIZE)) \
+		$(SQUASHFSOPT)
 endef
 
 ifeq ($(CONFIG_TARGET_ROOTFS_SECURITY_LABELS),y)
@@ -415,6 +420,12 @@
 
   FS_OPTIONS/ubifs = $$(MKUBIFS_OPTS)
 
+  # squashfs block size for this device in KiB, empty = target default
+  # (CONFIG_TARGET_SQUASHFS_BLOCK_SIZE). Preset from SQUASHFS_BLOCKSIZE/<device>
+  # so that a build system can choose it per device without touching the
+  # device definitions; a device definition may set it as well.
+  DEVICE_SQUASHFS_BLOCKSIZE := $$(strip $$(SQUASHFS_BLOCKSIZE/$(1)))
+
   DEVICE_DTS :=
   DEVICE_DTS_CONFIG :=
   DEVICE_DTS_DELIMITER :=
@@ -643,6 +654,8 @@
 	$(KDIR)/root.$(1)$$(strip \
 		$$(if $$(FS_OPTIONS/$(1)),+fs=$$(call param_mangle,$$(FS_OPTIONS/$(1)))) \
 	)$$(strip \
+		$(if $(filter squashfs,$(1)),$$(if $$(DEVICE_SQUASHFS_BLOCKSIZE),+bs=$$(DEVICE_SQUASHFS_BLOCKSIZE)k)) \
+	)$$(strip \
 		$(if $(TARGET_PER_DEVICE_ROOTFS),+pkg=$$(ROOTFS_ID/$(3))) \
 	)
   ifndef IB
