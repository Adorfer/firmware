From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Freifunk im Neanderland <projekt@neanderfunk.de>
Date: Sat, 12 Sep 2026 23:00:00 +0200
Subject: respondd-module-airtime: leave out busy/rx/tx larger than active

busy, rx and tx are shares of the channel time and can never exceed it.
mt76 (MT7915/MT7981 family) sometimes reports survey counters that ran
below zero, close to 2^64, and keep counting from there. Passed on
unchecked, json_object_new_int64() turns them into negative numbers, and
the map shows channel utilisation far above 100 % or below 0.

Seen on the Neanderfunk map, 12 h of 5-minute deltas: 345 values outside
0..1, almost all from mt76 radios. D-Link DAP-X1860: busy stuck at about
9.3e15 ms. ZyXEL NWA50AX Pro (MT7981): busy 18446744072895899 while active
is 27980645.

Such a value is now left out of the entry; frequency, noise and active
stay, so the map shows no utilisation instead of nonsense. Plausible
values are passed on unchanged (compared on a Cudy WR3000S against the
unpatched module on a second respondd port: identical).

Not covered: counters that jump between different series which are each
below active; that needs a fix in mt76 or a map that discards implausible
deltas.

Signed-off-by: Freifunk im Neanderland <projekt@neanderfunk.de>
---
 net/respondd-module-airtime/Makefile      |  2 +-
 net/respondd-module-airtime/src/airtime.c | 54 +++++++++++++++++++++++
 2 files changed, 55 insertions(+), 1 deletion(-)

diff --git a/net/respondd-module-airtime/Makefile b/net/respondd-module-airtime/Makefile
index 6a6e450..1b81641 100644
--- a/net/respondd-module-airtime/Makefile
+++ b/net/respondd-module-airtime/Makefile
@@ -2,7 +2,7 @@ include $(TOPDIR)/rules.mk
 
 PKG_NAME:=respondd-module-airtime
 PKG_VERSION:=1
-PKG_RELEASE:=2
+PKG_RELEASE:=3
 
 PKG_LICENSE:=BSD-2-Clause
 
diff --git a/net/respondd-module-airtime/src/airtime.c b/net/respondd-module-airtime/src/airtime.c
index 9ce35a1..5594f89 100644
--- a/net/respondd-module-airtime/src/airtime.c
+++ b/net/respondd-module-airtime/src/airtime.c
@@ -44,6 +44,36 @@ static const char *const msg_names[NL80211_SURVEY_INFO_MAX + 1] = {
 	[NL80211_SURVEY_INFO_NOISE] = "noise",
 };
 
+static bool nla_get_uint(struct nlattr *nla, uint64_t *value) {
+	switch (nla_len(nla)) {
+		case sizeof(uint64_t):
+			*value = nla_get_u64(nla);
+			return true;
+		case sizeof(uint32_t):
+			*value = nla_get_u32(nla);
+			return true;
+		default:
+			return false;
+	}
+}
+
+/*
+ * busy, rx and tx are shares of the channel time ("active") and can never be
+ * larger than it. mt76 (MT7915/MT7981) sometimes reports counters that ran
+ * below zero (close to 2^64, which json-c turns into a negative int64) or
+ * that stick at such a value and keep counting from there. Such a value is
+ * left out, so the map shows no utilisation instead of several thousand
+ * percent; frequency, noise and active stay.
+ */
+static void add_share(struct json_object *obj, const char *name, bool have, uint64_t value, uint64_t active) {
+	if (!have || value > active)
+		return;
+
+	struct json_object *data_json = json_object_new_int64(value);
+	if (data_json)
+		json_object_object_add(obj, name, data_json);
+}
+
 static int survey_airtime_handler(struct nl_msg *msg, void *arg) {
 	struct json_object **result = arg;
 	struct json_object *freq_json = NULL;
@@ -72,6 +102,11 @@ static int survey_airtime_handler(struct nl_msg *msg, void *arg) {
 	// required attributes.
 	unsigned int req_fields = 0;
 
+	// active, busy, rx and tx as numbers; busy, rx and tx are only added
+	// to the JSON object after the loop, once active is known.
+	uint64_t active = 0, busy = 0, rx = 0, tx = 0;
+	bool have_busy = false, have_rx = false, have_tx = false;
+
 	int rem;
 	struct nlattr *nla;
 	nla_for_each_nested(nla, survey_info, rem) {
@@ -88,6 +123,21 @@ static int survey_airtime_handler(struct nl_msg *msg, void *arg) {
 				req_fields++;
 		}
 
+		switch (type) {
+			case NL80211_SURVEY_INFO_CHANNEL_TIME:
+				nla_get_uint(nla, &active);
+				break;
+			case NL80211_SURVEY_INFO_CHANNEL_TIME_BUSY:
+				have_busy = nla_get_uint(nla, &busy);
+				continue;
+			case NL80211_SURVEY_INFO_CHANNEL_TIME_RX:
+				have_rx = nla_get_uint(nla, &rx);
+				continue;
+			case NL80211_SURVEY_INFO_CHANNEL_TIME_TX:
+				have_tx = nla_get_uint(nla, &tx);
+				continue;
+		}
+
 		if (!msg_names[type])
 			continue;
 
@@ -120,6 +170,10 @@ static int survey_airtime_handler(struct nl_msg *msg, void *arg) {
 		return NL_OK;
 	}
 
+	add_share(freq_json, msg_names[NL80211_SURVEY_INFO_CHANNEL_TIME_BUSY], have_busy, busy, active);
+	add_share(freq_json, msg_names[NL80211_SURVEY_INFO_CHANNEL_TIME_RX], have_rx, rx, active);
+	add_share(freq_json, msg_names[NL80211_SURVEY_INFO_CHANNEL_TIME_TX], have_tx, tx, active);
+
 	*result = freq_json;
 	return NL_STOP;
 }
