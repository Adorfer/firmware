 		'id': function(value) {
 			return value;
 		},
+		// neanderfunk-respondd: ein Ethernet-Port {carrier, speed, duplex, possible}
+		'nfLink': function(value) {
+			if (!value || typeof value !== 'object')
+				return '-';
+			if (!value.carrier)
+				return '\u2013';
+			if (!(value.speed > 0))
+				return 'up';
+			var s = value.speed + ' MBit/s';
+			if (value.duplex === 'half')
+				s += ' (half duplex)';
+			else if (value.possible > value.speed)
+				s += ' (' + value.possible + ' possible)';
+			return s;
+		},
 		'decimal': function(value) {
 			return formatNumberFixed(value, 2);
 		},
